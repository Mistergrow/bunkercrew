# Set a real DNS name pointing at your own server before enabling Caddy.
RELAY_DOMAIN=play.example.com
# Native Godot clients do not send Origin. Browser clients require an exact allowlist.
RELAY_ALLOWED_ORIGINS=
RELAY_MAX_ROOMS=256
RELAY_MAX_CONNECTIONS=768
# Friends are durable in the social_data volume mounted at /data.
# Native Python runs can set SOCIAL_DB to an absolute SQLite path instead.
# Optional: change subnet/address together if this private bridge already exists.
RELAY_PROXY_SUBNET=172.30.247.0/29
RELAY_CADDY_IP=172.30.247.3
# Without this variable the relay trusts exactly the bundled Caddy (RELAY_CADDY_IP/32).
# For a TLS proxy on the Docker host instead of the bundled Caddy, the relay sees
# connections to its published loopback port arrive from the bridge gateway, the
# first address of RELAY_PROXY_SUBNET; trust that address, not the Caddy one:
# RELAY_TRUSTED_PROXIES=172.30.247.1/32
# Never list client networks or 0.0.0.0/0 here.
# Optional abuse limits (defaults shown); each address is one IPv4 or one IPv6 /64.
# RELAY_MAX_CONNECTIONS_PER_IP=64
# RELAY_MAX_ROOMS_PER_IP=8
# Seconds until a never-started lobby without any guest is closed; 0 disables.
# RELAY_LOBBY_IDLE_SECONDS=3600
# Bytes queued towards slow receivers in total; keep well below the 512m limit.
# RELAY_MAX_OUTBOUND_BYTES=67108864
# SOCIAL_MAX_SESSIONS_PER_IP=8
