# Set a real DNS name pointing at your own server before enabling Caddy.
RELAY_DOMAIN=play.example.com
# Native Godot clients do not send Origin. Browser clients require an exact allowlist.
RELAY_ALLOWED_ORIGINS=
RELAY_MAX_ROOMS=256
RELAY_MAX_CONNECTIONS=768
# Friends are durable in the social_data volume mounted at /data.
# Native Python runs can set SOCIAL_DB to an absolute SQLite path instead.
# Optional: change subnet/address together if this private bridge already exists.
RELAY_PROXY_SUBNET=172.30.247.0/29
RELAY_CADDY_IP=172.30.247.3
# For an external TLS proxy instead of the bundled Caddy, trust its exact IP/CIDR.
# RELAY_TRUSTED_PROXIES=172.30.247.3/32
