extends RefCounted
## Dedicated menu composition; gameplay keeps its independent environment scores.
const TITLE := "Bunkercrew · Nachtschicht"
const STREAM_PATH := "res://assets/audio/menu_rave_v1.ogg"
const BPM := 128.0
const SAMPLE_RATE := 48000
const BARS := 32
const SECONDS := 60.0
const SEED := 0x42435256
const SECONDARY_TRACK := 8 # Actual short offbeat bass, independent of the kick.
const SECONDARY_REFERENCE_STRENGTH := 0.51
const TRACK_IDS := ["nachtschicht", "kernimpuls", "nachtstrom", "schichtwechsel"]
const TRACK_COUNT := 4
const Measurements := preload("res://scripts/rave_music_measurements.gd")
static var _next_track := 0

static func selected_track() -> Dictionary:
	if _next_track == 0:
		return {"id":"nachtschicht","title":TITLE,"stream_path":STREAM_PATH,"bpm":BPM,"seconds":SECONDS,
			"kick_samples":KICK_SAMPLES,"kick_strengths":KICK_STRENGTHS,
			"secondary_samples":SECONDARY_SAMPLES,"secondary_strengths":SECONDARY_STRENGTHS}
	var track_id: String = TRACK_IDS[_next_track]
	var result: Dictionary = Measurements.TRACKS[track_id].duplicate(true)
	result.id = track_id
	result.stream_path = "res://assets/audio/" + str(result.asset)
	return result

static func advance_after_match() -> void:
	# Process-local only: fresh launches always greet the player with Nachtschicht.
	# An actual played session advances the next menu, never a submenu or preview.
	_next_track = (_next_track + 1) % TRACK_COUNT

static func reset_rotation() -> void:
	_next_track = 0
