set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT MINGW_ROOT)
 set(MINGW_ROOT "$ENV{HOME}/.cache/bunkercrew-mingw")
endif()
set(CMAKE_C_COMPILER "${MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "${MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "${MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MINGW_ROOT}/usr/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
