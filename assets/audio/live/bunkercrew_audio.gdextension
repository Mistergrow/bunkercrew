[configuration]
entry_symbol = "bunkercrew_audio_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://assets/audio/live/libbunkercrew_audio.linux.x86_64.so"
linux.release.x86_64 = "res://assets/audio/live/libbunkercrew_audio.linux.x86_64.so"
windows.debug.x86_64 = "res://assets/audio/live/bunkercrew_audio.windows.x86_64.dll"
windows.release.x86_64 = "res://assets/audio/live/bunkercrew_audio.windows.x86_64.dll"
